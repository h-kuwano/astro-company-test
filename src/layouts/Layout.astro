---
const { title = 'ホーム', description = '株式会社サンプルの公式サイトです。' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (path: string) => `${base}${path}`;
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title} | 株式会社サンプル</title>
  <style is:global>
    :root{font-family:system-ui,-apple-system,'Noto Sans JP',sans-serif;color:#203044;background:#f7f9fc}*{box-sizing:border-box}body{margin:0;line-height:1.8}a{color:#1167a8}header{background:#102c48;color:white}header .inner{max-width:1050px;margin:auto;padding:20px 24px;display:flex;justify-content:space-between;gap:20px;align-items:center;flex-wrap:wrap}header a{color:white;text-decoration:none}nav{display:flex;gap:18px;flex-wrap:wrap;font-size:14px}.logo{font-weight:800;font-size:20px}main{max-width:1050px;margin:auto;padding:45px 24px;min-height:65vh}h1{font-size:clamp(28px,4vw,44px);line-height:1.3;margin:0 0 24px}h2{font-size:24px;margin:32px 0 16px}.lead{font-size:19px;color:#4d6478}.card{background:white;border:1px solid #dce5ee;border-radius:12px;padding:24px;margin:14px 0;box-shadow:0 2px 12px #122c4808}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}.muted{color:#62758a}.button{display:inline-block;border:0;border-radius:8px;background:#1269a4;color:white;text-decoration:none;padding:10px 20px;cursor:pointer;font:inherit}.button:hover{background:#0c4b78}.date{font-size:13px;color:#607489}.article img,.staff-photo{max-width:100%;height:auto;border-radius:10px}.staff-photo{width:160px;aspect-ratio:1;object-fit:cover}footer{background:#102c48;color:#dbe7f3;text-align:center;padding:25px;margin-top:45px}table{width:100%;border-collapse:collapse;background:white}th,td{padding:14px;border-bottom:1px solid #e0e7ef;text-align:left}th{width:28%;background:#eef3f8}label{display:block;font-weight:600;margin-top:18px}input,textarea{width:100%;padding:12px;border:1px solid #b9c9d8;border-radius:7px;font:inherit}textarea{min-height:140px}.hero{background:linear-gradient(120deg,#153e61,#247aa4);color:white;padding:55px 35px;border-radius:16px}.hero p{color:#e6f5ff}@media(max-width:650px){main{padding:30px 16px}header .inner{padding:16px}nav{gap:12px}th,td{display:block;width:100%}}
  </style>
</head>
<body>
<header><div class="inner"><a class="logo" href={link('/')}>株式会社サンプル</a><nav aria-label="メインメニュー"><a href={link('/')}>ホーム</a><a href={link('/about/')}>会社概要</a><a href={link('/staff/')}>スタッフ紹介</a><a href={link('/news/')}>お知らせ</a><a href={link('/contact/')}>お問い合わせ</a></nav></div></header>
<main><slot /></main>
<footer><small>© 2026 株式会社サンプル（学習用ダミーサイト）</small></footer>
</body></html>
